    "annotations": {
      "composition_data": {
        "property_unit": {
          "match_value": "<class 'int'>",
          "reference": "typing.Optional[typing.Any]",
          "test": "typing.Optional[typing.Any]"
        },
        "family": {
          "match_value": "<class 'int'>",
          "reference": "typing.Optional[typing.Any]",
          "test": "typing.Optional[typing.Any]"
        },
        "compositions_property_values": {
          "reference": "typing.Dict[str, typing.Any]",
          "test": "typing.Dict[str, typing.Any]",
          "key_matches": {
            "annotation": "typing.List[comproscanner.post_processing.evaluation.eval_flow.crews.composition_evaluation_crew.composition_evaluation_crew.KeyMatch]",
            "items": {
              "reference_key": "<class 'str'>",
              "test_key": "<class 'str'>",
              "match_value": "<class 'int'>"
            }
          },
          "value_matches": {
            "annotation": "typing.List[comproscanner.post_processing.evaluation.eval_flow.crews.composition_evaluation_crew.composition_evaluation_crew.ValueMatch]",
            "items": {
              "reference_key": "<class 'str'>",
              "test_key": "<class 'str'>",
              "reference_value": "typing.Any",
              "test_value": "typing.Any",
              "match_value": "<class 'int'>"
            }
          },
          "pair_matches": {
            "annotation": "typing.List[comproscanner.post_processing.evaluation.eval_flow.crews.composition_evaluation_crew.composition_evaluation_crew.PairMatch]",
            "items": {
              "reference_pair": "typing.Dict[str, typing.Union[int, float]]",
              "test_pair": "typing.Dict[str, typing.Union[int, float]]",
              "match_value": "<class 'int'>"
            }
          },
          "total_ground_truth_keys": "<class 'int'>",
          "total_match": "<class 'int'>",
          "missing_keys": "typing.List[str]",
          "extra_keys": "typing.List[str]"
        }
      }
    }
